# Files in site/ that `wrangler deploy --assets ./site` must not upload.
# Same syntax as .gitignore.

.assetsignore

# Build sources and host config -- the site serves the compiled CSS only.
sass/
*.map
netlify.toml

# Images nothing references: no page, script or stylesheet, and no
# listing_images row in the database. Listing photos are stored in the DB as
# "/Images/<file>" paths, so check the database (not just the code) before
# adding an image here.
#
# The original "Hero <name>.jpg" photos -- the hero uses the resized
# "hero-<name>.jpg" copies. "Hero " with a space, so hero-*.jpg never match.
Images/Hero *.jpg
Images/Retro Band T-Shirt.jpg
